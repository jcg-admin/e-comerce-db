# =============================================================================
# .gitignore — Kaupamex-db
# =============================================================================

# Variables de entorno — nunca en control de versión
.env

# Artefactos de backup generados por scripts/backup_db.sh
backups/*.sql
backups/*.sql.gz
backups/*.md5
backups/*.log

# Temporales de sistema
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Logs generales
# `*.log` NO se ignora — directiva del ejecutor 2026-09-10. Un log de una
# corrida es evidencia fechada: el nivel 4 de `niveles-de-retencion.md` es
# completitud percibida SIN persistencia, y un log ignorado es tan durable como
# el contenedor. Lo que sigue ignorado es ruido de dependencia o de motor, no
# rastro de lo que la sesion hizo.
logs/

# Backup de proyectos — proyectos/ se incluye en control de versión
# Los artefactos .bundle, .tar.gz, .md5 y .log dentro de proyectos/ SÍ se commiten
# (a diferencia de los dumps SQL de backups/ que van excluidos)
!backups/proyectos/
!backups/proyectos/**
backups/
